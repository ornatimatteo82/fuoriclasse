{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fuoriclasse.app/schemas/curriculum.schema.json",
  "title": "Fuoriclasse Curriculum Schema",
  "description": "Schema di validazione per le unità didattiche, lezioni e modalità extra di Fuoriclasse (1000+ domande)",
  "type": "object",
  "required": ["metadata", "units", "extraModes"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["version", "title", "language", "lastReviewed"],
      "properties": {
        "version": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "language": { "type": "string", "enum": ["it"] },
        "lastReviewed": { "type": "string", "format": "date" },
        "totalQuestions": { "type": "integer", "minimum": 1000 }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "number", "title", "subtitle", "lessons"],
        "properties": {
          "id": { "type": "string" },
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "themeColor": { "type": "string" },
          "lessons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "subtitle", "questions"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "subtitle": { "type": "string" },
                "questions": {
                  "type": "array",
                  "minItems": 5,
                  "maxItems": 5,
                  "items": {
                    "oneOf": [
                      { "$ref": "#/$defs/playerQuestion" },
                      { "$ref": "#/$defs/quizQuestion" }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "extraModes": {
      "type": "object",
      "required": ["goals", "scorers"],
      "properties": {
        "goals": {
          "type": "array",
          "items": { "$ref": "#/$defs/quizQuestion" }
        },
        "scorers": {
          "type": "array",
          "items": { "$ref": "#/$defs/quizQuestion" }
        },
        "derby": {
          "type": "array",
          "items": { "$ref": "#/$defs/quizQuestion" }
        },
        "champions": {
          "type": "array",
          "items": { "$ref": "#/$defs/quizQuestion" }
        }
      }
    }
  },
  "$defs": {
    "playerQuestion": {
      "type": "object",
      "required": ["id", "name", "number", "clubs", "options", "correct", "sourceType", "sourceTitle", "sourceUrl", "check"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "number": { "type": "integer" },
        "clubs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": [
              { "type": "string", "description": "Nome completo del club" },
              { "type": "string", "description": "Sigla del club" },
              { "type": "string", "description": "Chiave grafica maglia" },
              { "type": "integer", "description": "Anno inizio militanza" }
            ]
          }
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "correct": { "type": "string" },
        "wiki": { "type": "string" },
        "qid": { "type": "string" },
        "sourceType": { "type": "string", "enum": ["curated", "official"] },
        "sourceTitle": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "check": { "type": "string" }
      }
    },
    "quizQuestion": {
      "type": "object",
      "required": ["id", "question", "route", "options", "correct", "sourceType", "sourceTitle", "sourceUrl", "check"],
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "route": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "string" }
          }
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "correct": { "type": "string" },
        "sourceType": { "type": "string", "enum": ["official", "curated"] },
        "sourceTitle": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "check": { "type": "string" }
      }
    }
  }
}
